# Copy to .env:  cp .env.example .env
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/taskmanager
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/taskmanager_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
